        <div style="background: #ffffff; width: 100%; max-width: 448px; border-top-left-radius: 24px; border-top-right-radius: 24px; padding: 20px; max-height: 85vh; display: flex; flex-direction: column; box-shadow: 0 -10px 25px rgba(0,0,0,0.1);">
            
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #f1f5f9; padding-bottom: 12px;">
