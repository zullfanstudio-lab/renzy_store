                    <div style="display: flex; gap: 12px; align-items: flex-start; flex: 1; min-width: 0;">
                        <div style="width: 40px; height: 40px; background: ${primaryBg}; border: 1px solid ${primaryBorder}; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; overflow: hidden;">${iconContent}</div>
                        <div style="flex: 1; min-width: 0;">
                            <h3 style="font-size: 13px; font-weight: 800; color: #0f172a; margin: 0 0 2px 0;">${s.title} <span style="font-size: 9px; background: ${primaryBg}; color: ${primaryColor}; border: 1px solid ${primaryBorder}; padding: 2px 6px; border-radius: 4px;">${currentMode}</span></h3>
                            <p style="font-size: 11px; color: #64748b; margin: 0; line-height: 1.3;">${s.desc}</p>
                            <div style="font-size: 13px; font-weight: 800; color: ${primaryColor}; margin-top: 6px;">
                                Rp ${activePrice.toLocaleString('id-ID')} <span style="font-size: 10px; color: #94a3b8; font-weight: 400;">/${s.per} item</span>
                            </div>
                            <div style="font-size: 10px; color: #94a3b8; margin-top: 2px;">Minimal ${s.min} item</div>
                        </div>
                    </div>
                    <button onclick="openOrderModal(${s.id})" style="background: ${primaryColor}; color: #ffffff; font-size: 13px; font-weight: 800; padding: 8px 20px; border-radius: 12px; border: none; cursor: pointer; flex-shrink: 0; box-shadow: 0 2px 6px ${isReg ? 'rgba(37, 99, 235, 0.3)' : 'rgba(160, 44, 201, 0.3)'};">Beli</button>
                `;
                container.appendChild(card);
            });
        }

        function filterCategory(cat, btn) {
            document.querySelectorAll('.chip-pill').forEach(b => {
                b.classList.remove('active');
                b.style.backgroundColor = '#ffffff';
                b.style.color = '#334155';
                b.style.borderColor = '#e2e8f0';
            });
            btn.classList.add('active');
            const primaryColor = currentMode === 'Reguler' ? '#2563eb' : '#A02CC9';
            btn.style.backgroundColor = primaryColor;
            btn.style.color = '#ffffff';
            btn.style.borderColor = primaryColor;
            renderServices(cat);
        }

        // FUNGSI KERANJANG & DRAWER SLIDE DARI KANAN
        function toggleCartDrawer() {
            const drawer = document.getElementById('cartDrawer');
            const overlay = document.getElementById('cartDrawerOverlay');
            const isOpen = drawer.style.right === '0px';

            if(isOpen) {
                drawer.style.right = '-100%';
                overlay.style.display = 'none';
            } else {
                drawer.style.right = '0px';
                overlay.style.display = 'block';
                renderCartItems();
            }
        }

        document.getElementById('cartDrawerOverlay').onclick = function() {
            toggleCartDrawer();
        };

        function renderCartItems() {
            const container = document.getElementById('cartItemsList');
            container.innerHTML = '';

            const badge = document.getElementById('cartBadge');
            const miniBadge = document.getElementById('drawerBadgeMini');
            document.getElementById('drawerItemCount').innerText = `${cart.length} layanan dipilih`;

            if(cart.length === 0) {
                badge.style.display = 'none';
                miniBadge.style.display = 'none';
                container.innerHTML = `<div style="text-align: center; padding: 40px 20px; color: #94a3b8; font-size: 13px;">Keranjang belanja masih kosong.</div>`;
                document.getElementById('cartTotalPrice').innerText = 'Rp 0';
                return;
            }

            badge.style.display = 'flex';
            badge.innerText = cart.length;
            miniBadge.style.display = 'flex';
            miniBadge.innerText = cart.length;

            let totalSum = 0;
            const primaryColor = currentMode === 'Reguler' ? '#2563eb' : '#A02CC9';
            const primaryBg = currentMode === 'Reguler' ? '#eff6ff' : '#f3e8ff';

            cart.forEach((item, index) => {
                totalSum += item.totalPrice;
                
                let iconContent = '';
                if(item.iconImg) {
                    iconContent = `<img src="${item.iconImg}" alt="icon" style="width: 20px; height: 20px; object-fit: contain; border-radius: 50%;">`;
                } else {
                    iconContent = item.icon || '⚡';
                }

                container.innerHTML += `
                    <div style="display: flex; align-items: flex-start; justify-content: space-between; padding-bottom: 14px; border-bottom: 1px dashed #e2e8f0; gap: 10px;">
                        <div style="display: flex; gap: 10px; align-items: flex-start; flex: 1; min-width: 0;">
                            <div style="font-size: 16px; background: ${primaryBg}; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: 10px; flex-shrink: 0; color: ${primaryColor}; overflow: hidden;">${iconContent}</div>
                            <div style="flex: 1; min-width: 0;">
                                <h4 style="font-size: 13px; font-weight: 800; color: #0f172a; margin: 0 0 2px 0;">${item.title} (${item.mode})</h4>
                                <div style="font-size: 11px; color: #64748b; margin: 0;">${item.qty} item</div>
                                <div style="font-size: 11px; font-weight: 700; color: #0f172a; margin-top: 4px;">Rp ${item.totalPrice.toLocaleString('id-ID')}</div>
                            </div>
                        </div>
                        <button onclick="removeFromCart(${index})" style="background: none; border: none; color: #94a3b8; font-size: 16px; cursor: pointer; padding: 4px;">✕</button>
                    </div>
                `;
            });

            document.getElementById('cartTotalPrice').innerText = `Rp ${totalSum.toLocaleString('id-ID')}`;
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            localStorage.setItem('renzystore_cart', JSON.stringify(cart));
            renderCartItems();
        }

        function addToCart() {
            const target = document.getElementById('targetInput').value;
            const paymentMethod = document.getElementById('paymentMethod').value;

            if(!target) {
                alert('Silakan masukkan Link Akun atau Username target pesanan Anda!');
                return;
            }
            if(currentQty < selectedService.min) {
                alert(`Minimal pemesanan untuk layanan ini adalah ${selectedService.min}`);
                return;
            }

            const total = Math.round((currentQty / selectedService.per) * selectedService.activePrice);
            
            cart.push({
                title: selectedService.title,
                mode: currentMode,
                qty: currentQty,
                target: target,
                payment: paymentMethod,
                totalPrice: total,
                iconImg: selectedService.iconImg,
                icon: selectedService.icon
            });

            localStorage.setItem('renzystore_cart', JSON.stringify(cart));
            closeModal();
            toggleCartDrawer();
        }

        function checkoutCart() {
            if(cart.length === 0) {
                alert('Keranjang belanja masih kosong!');
                return;
            }

            let totalAll = 0;
            let text = `✨ *Pesanan Renzy Store* ✨\n\n`;

            cart.forEach((item, idx) => {
                totalAll += item.totalPrice;
                text += `*${idx + 1}. ${item.title} (${item.mode})*\n` +
                        `• Jumlah: ${item.qty}\n` +
                        `• Target: ${item.target}\n` +
                        `• Subtotal: Rp ${item.totalPrice.toLocaleString('id-ID')}\n\n`;
            });

            text += `💳 *Metode Pembayaran:* ${cart[0].payment}\n` +
                    `💰 *Total Pembayaran:* Rp ${totalAll.toLocaleString('id-ID')}\n\n` +
                    `Mohon diproses, terima kasih!`;

            const waNumber = "6283842227858";
            const waURL = `https://api.whatsapp.com/send?phone=${waNumber}&text=${encodeURIComponent(text)}`;
            window.open(waURL, '_blank');
        }

        function toggleAiModal() {
            const modal = document.getElementById('aiModal');
            modal.style.display = modal.style.display === 'flex' ? 'none' : 'flex';
        }

        function handleAiEnter(e) {
            if (e.key === 'Enter') sendAiMessage();
        }

        function sendAiMessage() {
            const input = document.getElementById('aiInput');
            const text = input.value.trim();
            if(!text) return;

            const primaryColor = currentMode === 'Reguler' ? '#2563eb' : '#A02CC9';
            const chatBox = document.getElementById('aiChatBox');
            chatBox.innerHTML += `<div style="background: ${primaryColor}; color: white; padding: 10px 14px; border-radius: 14px; font-size: 12px; max-width: 85%; align-self: flex-end;">${text}</div>`;
            input.value = '';
            chatBox.scrollTop = chatBox.scrollHeight;

            setTimeout(() => {
                let reply = `Halo! Anda dapat menambahkan beberapa layanan ke keranjang, lalu mengelolanya atau menghapusnya sebelum melakukan pembayaran via WhatsApp.`;
                const lower = text.toLowerCase();

                if(lower.includes('proses') || lower.includes('lama')) {
                    reply = "Proses pengerjaan memakan waktu 1x24 jam tergantung kondisi server.";
                } else if(lower.includes('keranjang') || lower.includes('hapus')) {
                    reply = "Anda bisa klik ikon keranjang di pojok kanan bawah untuk melihat daftar pesanan atau menghapusnya menggunakan tombol silang (×).";
                }

                chatBox.innerHTML += `<div style="background: #f1f5f9; padding: 10px 14px; border-radius: 14px; font-size: 12px; color: #334155; max-width: 85%; align-self: flex-start;">${reply}</div>`;
                chatBox.scrollTop = chatBox.scrollHeight;
            }, 600);
        }

        function openOrderModal(id) {
            selectedService = services.find(s => s.id === id);
            if(!selectedService) return;

            const activePrice = currentMode === 'Premium' ? (selectedService.pricePrem || Math.round(selectedService.price * 1.5)) : selectedService.price;
            selectedService.activePrice = activePrice;

            document.getElementById('modalTitle').innerText = `${selectedService.title} (${currentMode})`;
            
            const modalIconContainer = document.getElementById('modalIconContainer');
            if(selectedService.iconImg) {
                modalIconContainer.innerHTML = `<img src="${selectedService.iconImg}" alt="icon" style="width: 22px; height: 22px; object-fit: contain; border-radius: 50%;">`;
            } else {
                modalIconContainer.innerHTML = selectedService.icon || '⚡';
            }

            const modalRate = document.getElementById('modalRate');
            const modalSummaryBox = document.getElementById('modalSummaryBox');
            const modalSummaryLabel = document.getElementById('modalSummaryLabel');
            const totalPriceEl = document.getElementById('totalPrice');
            const modalSubmitBtn = document.getElementById('modalSubmitBtn');
            const primaryColor = currentMode === 'Reguler' ? '#2563eb' : '#A02CC9';
            const primaryBg = currentMode === 'Reguler' ? '#eff6ff' : '#f3e8ff';
            const primaryBorder = currentMode === 'Reguler' ? '#bfdbfe' : '#d8b4fe';

            modalRate.style.cssText = `font-size: 11px; font-weight: 700; color: ${primaryColor}; background: ${primaryBg}; border: 1px solid ${primaryBorder}; padding: 2px 8px; border-radius: 6px; display: inline-block; margin-top: 4px;`;
            modalSummaryBox.style.cssText = `background: linear-gradient(135deg, #ffffff 0%, ${primaryBg} 100%); border: 1px solid ${primaryBorder}; padding: 12px; border-radius: 12px; display: flex; justify-content: space-between; align-items: center;`;
            modalSummaryLabel.style.color = primaryColor;
            totalPriceEl.style.color = primaryColor;
            modalSubmitBtn.style.background = primaryColor;
            modalSubmitBtn.style.color = '#ffffff';
            modalSubmitBtn.style.boxShadow = `0 2px 6px ${currentMode === 'Reguler' ? 'rgba(37, 99, 235, 0.4)' : 'rgba(160, 44, 201, 0.4)'}`;

            document.getElementById('modalRate').innerText = `Rp ${activePrice.toLocaleString('id-ID')} / ${selectedService.per} item`;
            
            document.getElementById('preset50').innerText = `Rp ${Math.round((50 / selectedService.per) * activePrice).toLocaleString('id-ID')}`;
            document.getElementById('preset100').innerText = `Rp ${Math.round((100 / selectedService.per) * activePrice).toLocaleString('id-ID')}`;
            document.getElementById('preset200').innerText = `Rp ${Math.round((200 / selectedService.per) * activePrice).toLocaleString('id-ID')}`;
            document.getElementById('preset500').innerText = `Rp ${Math.round((500 / selectedService.per) * activePrice).toLocaleString('id-ID')}`;

            setQuantity(selectedService.min || 50);
            document.getElementById('orderModal').style.display = 'flex';
        }

        function closeModal() {
            document.getElementById('orderModal').style.display = 'none';
        }

        function setQuantity(qty) {
            document.getElementById('inputQty').value = qty;
            const primaryColor = currentMode === 'Reguler' ? '#2563eb' : '#A02CC9';
            const primaryBg = currentMode === 'Reguler' ? '#eff6ff' : '#f3e8ff';
            const primaryBorder = currentMode === 'Reguler' ? '#bfdbfe' : '#d8b4fe';
            
            [50, 100, 200, 500].forEach(val => {
                const btn = document.getElementById(`presetBtn${val}`);
                if(btn) {
                    if(val === qty) {
                        btn.style.border = `1.5px solid ${primaryColor}`;
                        btn.style.background = `linear-gradient(135deg, #ffffff 0%, ${primaryBg} 100%)`;
                    } else {
                        btn.style.border = `1px solid ${primaryBorder}`;
                        btn.style.background = `linear-gradient(135deg, #ffffff 0%, ${primaryBg} 100%)`;
                    }
                }
            });

            calculateTotal();
        }

        function calculateTotal() {
            const input = document.getElementById('inputQty');
            let qty = parseInt(input.value) || 0;
            currentQty = qty;

            const total = (qty / selectedService.per) * selectedService.activePrice;
            document.getElementById('totalPrice').innerText = `Rp ${Math.round(total).toLocaleString('id-ID')}`;
            document.getElementById('selectedCountText').innerText = `${qty} item`;
        }

        function toggleAdminModal() {
            const modal = document.getElementById('adminModal');
            modal.style.display = modal.style.display === 'flex' ? 'none' : 'flex';
            document.getElementById('adminPin').value = '';
        }

        function loginAdmin() {
            const pin = document.getElementById('adminPin').value;
            if(pin === 'zullfan ganteng 1102') {
                document.getElementById('adminAuth').style.display = 'none';
                document.getElementById('adminPanel').style.display = 'flex';
                renderAdminList();
            } else {
                alert('PIN Salah!');
                document.getElementById('adminPin').value = '';
            }
        }

        function renderAdminList() {
            const container = document.getElementById('adminServicesList');
            container.innerHTML = '';
            services.forEach((s, idx) => {
                container.innerHTML += `
                    <div style="display: flex; justify-content: space-between; align-items: center; font-size: 11px; padding: 8px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px;">
                        <div><strong>${s.title}</strong> - Reg: Rp ${s.price} | Prem: Rp ${s.pricePrem || s.price}</div>
                        <button onclick="deleteService(${idx})" style="color: #ef4444; border: none; background: none; font-weight: 700; cursor: pointer;">Hapus</button>
                    </div>
                `;
            });
        }

        function addService() {
            const title = document.getElementById('newTitle').value;
            const category = document.getElementById('newCat').value;
            const desc = document.getElementById('newDesc').value;
            const price = parseInt(document.getElementById('newPrice').value);
            const pricePrem = parseInt(document.getElementById('newPricePrem').value);
            const per = parseInt(document.getElementById('newPer').value);
            const min = parseInt(document.getElementById('newMin').value);

            if(!title || !price || !per) {
                alert('Mohon lengkapi formulir minimal nama, harga reguler, dan per item!');
                return;
            }

            const iconsMap = { TikTok: logoTikTok, Instagram: logoIG, WhatsApp: logoWA, Telegram: logoTele };

            services.push({
                id: Date.now(),
                title, category, desc, price, pricePrem: pricePrem || Math.round(price * 1.5), per, min: min || per,
                iconImg: iconsMap[category] || '',
                icon: '⚡'
            });

            saveServices();
            renderAdminList();
            alert('Layanan berhasil ditambahkan!');
        }

        function deleteService(idx) {
            if(confirm('Hapus layanan ini?')) {
                services.splice(idx, 1);
                saveServices();
                renderAdminList();
            }
        }

        updateDynamicTheme();
        renderServices('TikTok');
        if(cart.length > 0) {
            document.getElementById('cartBadge').style.display = 'flex';
            document.getElementById('cartBadge').innerText = cart.length;
        }
    </script>
</body>
</html>
