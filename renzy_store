            document.getElementById('adminAddTitle').style.color = isReg ? '#1e40af' : '#6b21a8';
        }

        function closeWelcomeModal() {
            document.getElementById('welcomeModal').style.display = 'none';
            document.getElementById('modeModal').style.display = 'flex';
        }

        function openModeModal() {
            document.getElementById('modeModal').style.display = 'flex';
        }

        function closeModeModal() {
            document.getElementById('modeModal').style.display = 'none';
        }

        function selectMode(mode) {
            currentMode = mode;
            const btn = document.getElementById('modeButton');
            if(mode === 'Premium') {
                btn.className = 'chip-mode-premium';
                btn.innerHTML = `👑 Mode Premium <span class="badge-ganti">Ganti</span>`;
            } else {
                btn.className = 'chip-mode-reguler';
                btn.innerHTML = `⚡ Mode Reguler <span class="badge-ganti">Ganti</span>`;
            }
            closeModeModal();
            updateDynamicTheme();
            renderServices(currentFilter);
            if(document.getElementById('cartDrawer').style.right === '0px') {
                renderCartItems();
            }
        }

        function saveServices() {
            localStorage.setItem('renzystore_services', JSON.stringify(services));
            renderServices(currentFilter);
        }

        function renderServices(filter) {
            currentFilter = filter;
            const container = document.getElementById('servicesList');
            container.innerHTML = '';

            const filtered = services.filter(s => s.category.toLowerCase() === filter.toLowerCase());
            document.getElementById('serviceCountText').innerText = `${filtered.length} layanan tersedia (${currentMode})`;

            if(filtered.length === 0) {
                container.innerHTML = `<div style="text-align: center; padding: 24px; color: #94a3b8; font-size: 12px; background: white; border-radius: 16px;">Tidak ada layanan untuk kategori ini.</div>`;
                return;
            }

            const isReg = currentMode === 'Reguler';
            const primaryColor = isReg ? '#2563eb' : '#A02CC9';
            const primaryBg = isReg ? '#eff6ff' : '#f3e8ff';
            const primaryBorder = isReg ? '#bfdbfe' : '#d8b4fe';

            filtered.forEach(s => {
                const activePrice = currentMode === 'Premium' ? (s.pricePrem || Math.round(s.price * 1.5)) : s.price;
                const card = document.createElement('div');
                
                let iconContent = '';
                if(s.iconImg) {
                    iconContent = `<img src="${s.iconImg}" alt="icon" style="width: 22px; height: 22px; object-fit: contain; border-radius: 50%;">`;
                } else {
                    iconContent = s.icon || '⚡';
                }

                card.style.cssText = `background: linear-gradient(135deg, #ffffff 0%, ${primaryBg} 100%); border: 1px solid ${primaryBorder}; border-radius: 16px; padding: 14px; display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; box-shadow: 0 2px 6px ${isReg ? 'rgba(37, 99, 235, 0.06)' : 'rgba(160, 44, 201, 0.06)'};`;
