    <!-- NAVBAR -->
    <div class="navbar">
        <div style="max-width: 448px; margin: 0 auto; width: 100%; display: flex; justify-content: space-between; align-items: center;">
            <div class="logo-box">
                <img src="https://cdn.phototourl.com/member/2026-10-25-c5fc1428-2b63-452d-a67c-15ba3a792db1.png" alt="Logo Renzy Store" class="logo-img">
